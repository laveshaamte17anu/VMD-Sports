# ─────────────────────────────────────────────────────────────
# VMD Sports – Frontend Environment Configuration Example
# Copy this file to .env and configure for development / production
# ─────────────────────────────────────────────────────────────

# Production Backend API URL (without trailing slash)
# Replace with your deployed backend URL on Render / Railway
# Example: https://vmd-sports-backend.onrender.com/api
VITE_API_URL=https://your-backend-service.onrender.com/api

# Site Title
VITE_SITE_NAME=VMD Sports
